# Backend selection: sqlite (default), postgres or files.
DATA_BACKEND=sqlite

# SQLite database file. On Vercel use /tmp/dhago.db (only /tmp is writable).
SQLITE_PATH=data/dhago.db

# Seed the demo accounts on first start. Set to 0 to disable.
SEED_DEMO_USERS=1
DEMO_ADMIN_EMAIL=admin@dhago.app
DEMO_ADMIN_PASSWORD=Admin@2026
DEMO_USER_EMAIL=demo@dhago.app
DEMO_USER_PASSWORD=Demo@2026

# Required for any shared deployment.
JWT_SECRET_KEY=replace-with-a-random-256-bit-secret

# Optional: PostgreSQL if DATA_BACKEND=postgres.
# DB_URL=postgresql://user:password@localhost:5432/lending
