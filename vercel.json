{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- \":(top)app\" \":(top)config\" \":(top)requirements.txt\" \":(top)requirements-ocr.txt\" \":(top)runtime.txt\" \":(top).python-version\" \":(top).vercelignore\" \":(top)vercel.json\" || exit 1",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "includeFiles": "{app/ScoringModel/**,config/**}",
      "excludeFiles": "{frontend/**,showcase/**,docs/**,legacy/**,experiments/**,tests/**,scripts/**}"
    }
  }
}
